DATABASE_URL=postgres://pocket:pocket@localhost:5432/pocket?sslmode=disable
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=100800
PORT=8000

# Password hashing work factor (4-31). Library default is 10 (~60ms/hash).
# Lower it on a slow host if register/login feel sluggish.
BCRYPT_COST=10

# In-memory cache TTL for authenticated GET responses, in seconds. 0 disables.
CACHE_TTL_SECONDS=30
