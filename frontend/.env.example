# Backend API URL — Vite dev server proxies /api to this target.
# Defaults to http://localhost:8000 (docker-compose overrides it to http://backend:8000).
VITE_API_URL=http://localhost:8000

# Comma-separated Host header allowlist for the Vite dev server.
# Leave UNSET for local/LAN dev (any host allowed, so phones on your wifi can
# connect via http://<your-lan-ip>:5173). Set it only for the public deployment.
# VITE_ALLOWED_HOSTS=pocket.infrasnow.com
